  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profiles for readers and creators."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private user PII and preferences."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Administrator role registry."
    },
    "/mangas/{mangaId}": {
      "schema": { "$ref": "#/entities/Manga" },
      "description": "Manga series catalog."
    },
    "/mangas/{mangaId}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Chapters strictly isolated per manga."
    },
    "/mangas/{mangaId}/chapters/{chapterId}/pages/{pageId}": {
      "schema": { "$ref": "#/entities/Page" },
      "description": "Chapter pages pairing original image and optional Motion asset."
    },
    "/mangas/{mangaId}/chapters/{chapterId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Chapter comments."
    },
    "/mangas/{mangaId}/ratings/{userId}": {
      "schema": { "$ref": "#/entities/Rating" },
      "description": "User ratings per manga."
    },
    "/mangas/{mangaId}/readers/{userId}": {
      "schema": { "$ref": "#/entities/MangaReader" },
      "description": "Readers with this manga in their Continue Reading history."
    },
    "/mangas/{mangaId}/wishlist/{userId}": {
      "schema": { "$ref": "#/entities/MangaWishlist" },
      "description": "Wishlist subscribers for pre-launch and launch notifications."
    },
    "/manga_previews/{previewKey}": {
      "schema": { "$ref": "#/entities/MangaPreview" },
      "description": "Isolated private/early-access preview entry keyed by unguessable previewKey."
    },
    "/manga_previews/{previewKey}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/MangaPreviewChapter" },
      "description": "Prepared chapters available through an active private preview link."
    },
    "/manga_previews/{previewKey}/chapters/{chapterId}/pages/{pageId}": {
      "schema": { "$ref": "#/entities/MangaPreviewPage" },
      "description": "Pages of prepared chapters available through an active private preview link."
    },
    "/users/{userId}/history/{mangaId}": {
      "schema": { "$ref": "#/entities/ReadingHistory" },
      "description": "User reading history and auto-resume position."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/Follow" },
      "description": "Author follow relationships."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Moderation reports submitted by users."
    },
    "/monetization_settings/{settingsId}": {
      "schema": { "$ref": "#/entities/MonetizationSettings" },
      "description": "Monetization split policy and withdrawal rules."
    },
    "/monetization_payout_profiles/{creatorId}": {
      "schema": { "$ref": "#/entities/MonetizationPayoutProfile" },
      "description": "Creator Pix payout details isolated by owner and admin."
    },
    "/monetization_creator_balances/{creatorId}": {
      "schema": { "$ref": "#/entities/MonetizationCreatorBalance" },
      "description": "Creator financial balances in integer cents."
    },
    "/monetization_revenues/{revenueId}": {
      "schema": { "$ref": "#/entities/MonetizationRevenue" },
      "description": "Ad revenue records linked to works/chapters or unattributed."
    },
    "/monetization_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/MonetizationLedgerEntry" },
      "description": "Immutable internal financial ledger entries."
    },
    "/monetization_payout_requests/{requestId}": {
      "schema": { "$ref": "#/entities/MonetizationPayoutRequest" },
      "description": "Creator Pix withdrawal requests."
    },
    "/monetization_payout_payments/{paymentId}": {
      "schema": { "$ref": "#/entities/MonetizationPayoutPayment" },
      "description": "Admin manual Pix payout settlements."
    },
    "/monetization_idempotency/{key}": {
      "schema": { "$ref": "#/entities/MonetizationIdempotency" },
      "description": "Idempotency locks for financial mutations."
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/StimulusSettings" },
      "description": "Global platform feature settings such as gradual stimulus view ranges."
    }
  }
}
