    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile for readers and creators (no PII stored here).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "handle": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[a-zA-Z0-9_.\\-]+$" },
        "avatarUrl": { "type": "string", "maxLength": 600 },
        "bio": { "type": "string", "maxLength": 400 },
        "accountType": { "type": "string", "enum": ["reader", "creator"] },
        "followersCount": { "type": "number" },
        "worksCount": { "type": "number" },
        "isSuspended": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "handle", "avatarUrl", "bio", "accountType", "followersCount", "worksCount", "isSuspended", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private PII and reader preferences isolated under user subcollection.",
