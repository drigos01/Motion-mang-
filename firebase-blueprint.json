      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 160 },
        "preferredMode": { "type": "string", "enum": ["original", "motion"] },
        "nightMode": { "type": "boolean" },
        "layoutMode": { "type": "string", "enum": ["single", "vertical"] },
        "fitMode": { "type": "string", "enum": ["fit-width", "fit-height", "actual"] },
        "nightTheme": { "type": "string", "enum": ["oled", "slate", "warm-dark"] },
        "brightness": { "type": "number" },
        "zoom": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "preferredMode", "nightMode", "createdAt", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
